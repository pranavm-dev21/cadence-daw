{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cadence",
  "version": "0.1.0",
  "identifier": "com.cadence.daw",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence DAW",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "AudioVideo",
    "shortDescription": "Cadence Open-Source Digital Audio Workstation",
    "longDescription": "Next-generation AI-powered digital audio workstation for music creation, recording, MIDI sequencing, and mixing across Windows, macOS, and Linux.",
    "copyright": "Copyright 2026 Cadence Contributors. Licensed under MIT.",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libasound2",
          "libasound2-plugins"
        ],
        "section": "sound"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
