# Optional cloud configuration. Local recording works with all values blank.
# Public browser settings: Supabase project URL and publishable/anon key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. NEVER prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SITE_ORIGIN=http://127.0.0.1:3000
API_PORT=8787
API_HOST=127.0.0.1
